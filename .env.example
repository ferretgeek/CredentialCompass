# Start safely with reserved synthetic data.
COMPASS_DEMO=true
COMPASS_BIND_HOST=127.0.0.1
COMPASS_PORT=8788
COMPASS_ALLOWED_HOSTS=localhost,127.0.0.1
# Set only when an exact reverse-proxy IP overwrites X-Forwarded-For.
COMPASS_TRUSTED_PROXY_IPS=

# Leave empty on loopback to generate an ephemeral token at startup.
COMPASS_ACCESS_TOKEN=

# Real mode: set COMPASS_DEMO=false, use your own endpoint and inject the key
# through the process environment or a mode-0600 service environment file.
COMPASS_CPA_URL=https://cliproxyapi.example.com
COMPASS_CPA_KEY=

# Destructive actions and the compatibility probe stay off by default.
COMPASS_ENABLE_LIVE_PROBE=false
COMPASS_ALLOW_STATUS_CHANGES=false
COMPASS_ALLOW_PRIVATE_HTTP=false
COMPASS_MAX_ACCOUNTS=1000
COMPASS_CONCURRENCY=4
COMPASS_REQUEST_TIMEOUT=15
