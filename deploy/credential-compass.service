[Unit]
Description=Credential Compass
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=credential-compass
Group=credential-compass
WorkingDirectory=/opt/credential-compass
EnvironmentFile=/etc/credential-compass.env
ExecStart=/opt/credential-compass/.venv/bin/python -m credential_compass
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
